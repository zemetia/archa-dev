{
  "name": "archa-dev",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @archa/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "cli": "pnpm --filter @archa/cli build",
    "dist": "pnpm --filter @archa/cli build && pnpm --filter @archa/desktop dist"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tslib": "^2.9.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "version": "0.1.0"
}
