{
  "name": "archa-dev",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/pnpm.mjs --filter @archa/desktop dev",
    "build": "node scripts/pnpm.mjs -r build",
    "typecheck": "node scripts/pnpm.mjs -r typecheck",
    "lint": "biome lint --error-on-warnings .",
    "test": "vitest run",
    "cli": "node scripts/pnpm.mjs --filter @archa/cli build",
    "dist": "node scripts/pnpm.mjs --filter @archa/cli build && node scripts/pnpm.mjs --filter @archa/desktop dist",
    "docs:links": "node scripts/gen-backlinks.mjs",
    "docs:check": "node scripts/gen-backlinks.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@phosphor-icons/core": "2.1.1",
    "@tabler/icons": "3.35.0",
    "@types/node": "^26.6.6",
    "fontkit": "^3.0.0",
    "heroicons": "2.2.0",
    "simple-icons": "16.38.0",
    "tslib": "^2.9.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "version": "0.2.3"
}
